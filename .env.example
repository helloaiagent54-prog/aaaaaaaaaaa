# Application Runtime
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Database (Mandatory MongoDB Atlas Connection String)
MONGODB_URI=

# Authentication & Security
JWT_SECRET=
JWT_EXPIRES_IN=7d
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Cloudinary (Mandatory Managed Image Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend Transactional Email
RESEND_API_KEY=
EMAIL_FROM=NOVARA COMMERCE <no-reply@novaracommerce.com>

# OAuth Providers (Optional - leave empty if unconfigured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Bangladesh Payment Gateway (e.g., sslcommerz)
PAYMENT_PROVIDER=sslcommerz
PAYMENT_STORE_ID=
PAYMENT_STORE_PASSWORD=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_SANDBOX=true

# Optional Google AdSense
VITE_ADSENSE_PUBLISHER_ID=
